{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "minimumVersion": "2.1.228",
  "fallbackModel": [
    "claude-sonnet-5-5",
    "claude-haiku-5-5"
  ],
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "25000",
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Skill",
      "AskUserQuestion",
      "NotebookEdit",
      "SendMessage",
      "Agent"
    ],
    "ask": [
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -R *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(rm -rfv *)",
      "Bash(rm --recursive *)",
      "PowerShell(Remove-Item *)"
    ],
    "deny": [
      "Workflow",
      "ScheduleWakeup",
      "Bash(rm -rf /*)",
      "Bash(rm -rf /)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * -O - | sh)",
      "Bash(wget * -O - | bash)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(.env)",
      "Edit(*.pem)",
      "Edit(*credentials*)",
      "Edit(*secret*)",
      "Read(*.pem)",
      "Read(*credentials*)",
      "Read(*secret*)",
      "Edit(.env.*)",
      "Edit(./secrets/**)",
      "PowerShell(irm * | iex)",
      "PowerShell(iwr * | iex)",
      "ShareOnboardingGuide",
      "SendFeedback",
      "ReportFindings"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.claude/hooks/headless-model-gate.ts\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bun \"$HOME/.claude/hooks/bash-output-shaper.ts\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.claude/hooks/remote-git-gate.ts\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.claude/hooks/design-file-hint.ts\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.claude/hooks/router/agent-hooks.ts\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.claude/hooks/haiku-context-brake.ts\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.claude/hooks/skill-activation.ts\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bun \"$HOME/.claude/hooks/prompt-router.ts\"",
            "async": true
          },
          {
            "type": "command",
            "command": "bun \"$HOME/.claude/hooks/turn-nudges.ts\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.claude/hooks/turn-nudges.ts\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "prompt-router",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.claude/hooks/router/agent-hooks.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.claude/hooks/instructions-loaded.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.claude/hooks/instructions-loaded.ts\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.claude/hooks/security-gate.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      ".venv"
    ],
    "baseRef": "head"
  },
  "enabledPlugins": {
    "cowork-plugin-management@synced": false
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "outputStyle": "Poneglyph",
  "language": "spanish",
  "theme": "dark",
  "tui": "fullscreen",
  "autoUpdatesChannel": "latest",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-haiku-5-5": {
      "autoCompactWindow": 120000
    }
  },
  "switchModelsOnFlag": false,
  "sandbox": {
    "enabled": false
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Pensando",
      "Analizando",
      "Investigando",
      "Procesando",
      "Evaluando",
      "Planificando",
      "Construyendo",
      "Revisando",
      "Optimizando"
    ]
  },
  "advisorModel": "opus",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "agentPushNotifEnabled": false,
  "remoteControlAtStartup": false,
  "preferredNotifChannel": "iterm2_with_bell",
  "editorMode": "normal",
  "skipDangerousModePermissionPrompt": true,
  "autoCompactEnabled": true,
  "autoCompactWindow": 300000,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "hard_deny": [
      "Bash(rm -rf .claude)",
      "Bash(rm -rf .claude/*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "soft_deny": [
      "$defaults",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.global.json)",
      "Write(.claude/settings.global.json)",
      "Bash(rm .claude)"
    ]
  },
  "skillListingMaxDescChars": 1,
  "skillOverrides": {
    "agent-routing": "name-only",
    "changes-explain": "name-only",
    "changes-verify": "name-only",
    "compare-and-decide": "name-only",
    "consult-model": "name-only",
    "deep-research": "name-only",
    "dev-workflow": "name-only",
    "diagrams-interactive": "name-only",
    "drillme-clarify": "name-only",
    "flow": "name-only",
    "harness-config": "name-only",
    "html-report": "name-only",
    "lessons-learned": "name-only",
    "natural-writing": "name-only",
    "pr-comments": "name-only",
    "pr-review": "name-only",
    "prompt-design": "name-only",
    "security-audit": "name-only",
    "troubleshooting": "name-only",
    "ui-design": "name-only"
  }
}
