      {
        "id": "compare",
        "label": "4 · Comparar en el tiempo",
        "focus": [
          "lab-experiment",
          "lab-oracle",
          "lab-history"
        ],
        "note": "Compara un factor: perfil o prompt. repeat conserva versiones; un entorno o motor incompatible exige otro experimento."
      }
